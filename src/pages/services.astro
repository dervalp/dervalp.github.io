---
import BlogLayout from "../layouts/BlogLayout.astro";
import { withBase } from "../utils/url";
import { siteData } from "../data/site";

const title = `Services | ${siteData.hero.name}`;
const description =
  "Three ways Pierre Derval works with CEOs and CTOs: AI and product direction, platform and delivery assessment, and hands-on executive advisory.";
const contactHref = withBase("/contact") + "?topic=General+inquiry";
---

<BlogLayout {title} {description}>
  <div class="exec-page home-wrap">
    <header class="exec-page__head">
      <p class="home-eyebrow">For CEOs and CTOs</p>
      <h1 class="exec-page__title">Three ways to work together.</h1>
      <p class="exec-page__intro">
        When AI, product and platform need to move together, the hard part is rarely the technology. It is connecting the business decision to the team and platform that have to deliver it.
      </p>
    </header>

    <div class="exec-themes">
      {siteData.engagements.map((engagement, index) => (
        <section class="exec-theme" id={engagement.id} aria-labelledby={`${engagement.id}-title`}>
          <span class="exec-engagement__number">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h2 class="exec-theme__title" id={`${engagement.id}-title`}>{engagement.title}</h2>
            <p class="exec-theme__summary">{engagement.summary}</p>
          </div>
          <div class="exec-theme__body">
            <p>{engagement.situation}</p>
            <h3 class="home-eyebrow">What we work on</h3>
            <ul>
              {engagement.workOn.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </section>
      ))}
    </div>

    <aside class="exec-page__next">
      <div>
        <h2 class="exec-page__next-title">Not sure which one fits?</h2>
        <p>
          Tell me what you are trying to change and we will work out the right scope together. The <a href={withBase("/tools")}>diagnostic tools</a> are a useful place to start.
        </p>
      </div>
      <a class="home-button" href={contactHref}>{siteData.hero.primaryCtaLabel} <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</BlogLayout>
