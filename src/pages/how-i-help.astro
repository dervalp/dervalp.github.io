---
import BlogLayout from "../layouts/BlogLayout.astro";
import { withBase } from "../utils/url";
import { siteData } from "../data/site";

const title = `How I help | ${siteData.hero.name}`;
const description =
  "How Pierre Derval helps CEOs and CTOs close the gap between AI ambition and shipped products, across direction, delivery and executive advisory.";
const contactHref = withBase("/contact") + "?topic=General+inquiry";
---

<BlogLayout {title} {description}>
  <div class="exec-page home-wrap">
    <header class="exec-page__head">
      <p class="home-eyebrow">Approach</p>
      <h1 class="exec-page__title">How I help.</h1>
      <p class="exec-page__intro">
        Most organisations do not have an AI problem. They have a readiness problem, a strategy problem or a delivery problem. AI just makes it visible faster.
      </p>
    </header>

    <div class="exec-themes">
      {siteData.engagements.map((engagement, index) => (
        <section class="exec-theme" aria-labelledby={`${engagement.id}-title`}>
          <span class="exec-engagement__number">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h2 class="exec-theme__title" id={`${engagement.id}-title`}>{engagement.title}</h2>
            <a class="home-link" href={withBase("/services") + `#${engagement.id}`}>What we work on <span aria-hidden="true">↗</span></a>
          </div>
          <div class="exec-theme__body">
            <p>{engagement.situation}</p>
            {engagement.approach.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>
      ))}
    </div>

    <aside class="exec-page__next">
      <div>
        <h2 class="exec-page__next-title">Not sure which applies?</h2>
        <p>
          The <a href={withBase("/tools")}>diagnostic tools</a> on this site are a good starting point. Or reach out directly: a short conversation usually makes it clear.
        </p>
      </div>
      <a class="home-button" href={contactHref}>{siteData.hero.primaryCtaLabel} <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</BlogLayout>
