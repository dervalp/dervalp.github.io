---
import BlogLayout from "../layouts/BlogLayout.astro";
import { withBase } from "../utils/url";
import { siteData } from "../data/site";

const { career } = siteData;
const title = `About · ${siteData.hero.name}`;
const description =
  "Pierre Derval is Head of AI at Vertuoza and the creator of Omni-loop, with 20+ years building enterprise software platforms across product, engineering and AI.";

const metrics = career.priorOutcomes;
const timeline = career.timeline;
---

<BlogLayout {title} {description}>
  <div class="about-page shell">

    <!-- Hero: photo + intro -->
    <div class="about-hero">
      <div class="about-hero__text reveal" style="--delay: 0ms">
        <p class="eyebrow">About</p>
        <h1 class="about-page__headline">Pierre Derval.<br />Head of AI at Vertuoza.</h1>
        <div class="about-page__bio">
          <p>I am an AI and product executive with 20+ years building and evolving enterprise software platforms. I connect product strategy, technical architecture and delivery to turn complex technology into products people use.</p>
          <p>Today I am Head of AI at Vertuoza, where I created the Omni-loop framework for AI-assisted engineering and, with the Platform team, brought AI Advisor and MCP capabilities into production. Before that I spent six years as Chief Product Technical Officer at CluedIn, an enterprise data management and AI platform serving regulated enterprises, after platform work at Adform and Sitecore.</p>
          <p>I also help CEOs and CTOs of software companies with the gap I keep meeting: genuine AI ambition, real capability, and stalled delivery. Not because the technology is wrong, but because decisions, architecture and execution are not aligned.</p>
        </div>
      </div>
      <div class="about-hero__photo reveal" style="--delay: 120ms">
        <div class="about-hero__photo-frame">
          <img
            src={withBase("/pierre-derval-profile.webp")}
            alt="Pierre Derval"
            width="400"
            height="500"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <!-- Current work: Vertuoza and Omni-loop -->
    {career.currentWork.map((work, i) => (
      <section class="about-ikary reveal" style={`--delay: ${130 + i * 10}ms`} aria-labelledby={`about-${work.id}`}>
        <p class="eyebrow">{work.label}{work.years && ` · ${work.years}`}</p>
        <h2 class="about-ikary__heading" id={`about-${work.id}`}>{work.name}</h2>
        <div class="about-ikary__body">
          {work.summary.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="about-ikary__links">
          <a href={work.url} target="_blank" rel="noopener noreferrer" class="button-secondary">{work.linkLabel} ↗</a>
        </div>
      </section>
    ))}

    <!-- Metrics band -->
    <div class="about-metrics-band reveal" style="--delay: 160ms">
      <p class="eyebrow about-metrics-band__eyebrow">{career.priorOutcomesLabel}</p>
      <div class="about-metrics-grid">
        {metrics.map((m) => (
          <div class="about-metric">
            <div class="about-metric__value-block">
              <span class="about-metric__value">{m.value}</span>
              {m.valueSub && <span class="about-metric__value-sub">{m.valueSub}</span>}
            </div>
            <span class="about-metric__label">{m.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Career timeline -->
    <div class="about-timeline reveal" style="--delay: 200ms">
      <p class="eyebrow">Career</p>
      <div class="about-timeline__list">
        {timeline.map((entry) => (
          <div class="about-timeline__entry">
            <div class="about-timeline__left">
              <span class="about-timeline__years">{entry.years}</span>
              <span class="about-timeline__location">{entry.location}</span>
            </div>
            <div class="about-timeline__marker" aria-hidden="true"></div>
            <div class="about-timeline__right">
              <p class="about-timeline__company">{entry.company}</p>
              <p class="about-timeline__role">{entry.role}</p>
              <p class="about-timeline__detail">{entry.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Earlier project: Ikary (secondary) -->
    <section class="about-ikary reveal" style="--delay: 220ms" aria-labelledby="about-ikary">
      <p class="eyebrow">Open-source research</p>
      <h2 class="about-ikary__heading" id="about-ikary">Ikary</h2>
      <div class="about-ikary__body">
        <p>Ikary Manifest is an open-source research project exploring a different approach to AI-built software: instead of generating code, generate a structured YAML manifest that describes what an application should do, and let a deterministic runtime compile it into a working system.</p>
        <p>It includes a declarative manifest language for business applications, a compilation engine, contract validation and a multi-runtime renderer. It is early work, not a product.</p>
      </div>
      <div class="about-ikary__links">
        <a href="https://github.com/ikary-platform/ikary-manifest" target="_blank" rel="noopener noreferrer" class="button-secondary">GitHub repository</a>
        <a href="https://ikary.co" target="_blank" rel="noopener noreferrer" class="button-secondary">ikary.co</a>
      </div>
    </section>

    <!-- CTA -->
    <div class="about-cta reveal" style="--delay: 240ms">
      <p class="eyebrow">Ready to talk?</p>
      <h2 class="about-cta__heading">Bring the challenge you are facing.</h2>
      <p class="about-cta__body">A few lines of context are enough to start.</p>
      <div class="about-ikary__links">
        <a href={withBase("/contact") + "?topic=General+inquiry"} class="button-primary">
          Discuss your challenge →
        </a>
        <a href={withBase(siteData.socials.resumePath)} class="button-secondary" download>
          Download CV
        </a>
      </div>
    </div>

  </div>
</BlogLayout>
