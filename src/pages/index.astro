---
import { getCollection } from "astro:content";
import HeaderNav from "../components/HeaderNav.astro";
import { siteData } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortedPosts } from "../utils/blog";
import { withBase } from "../utils/url";

const { career, engagements, hero } = siteData;
const contactHref = withBase("/contact");
const resumeHref = withBase(siteData.socials.resumePath);

const featuredSlugs = ["omni-loop-agents-ship-you-steer", "what-makes-a-codebase-agent-ready"];
const allPosts = sortedPosts(await getCollection("blog", ({ data }) => !data.draft));
const featured = featuredSlugs.flatMap((slug) => allPosts.filter((post) => post.slug === slug));
const articles = featured.length === featuredSlugs.length ? featured : allPosts.slice(0, 2);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "2-digit", month: "long", year: "numeric" });

const [featuredQuote, ...otherQuotes] = [
  {
    quote: "Pierre combines a strong helicopter view with the ability to dive deep into product engineering when needed.",
    name: "Melvin Rook",
    role: "CTO",
  },
  {
    quote: "Pierre shows a remarkable combination of deep technical skill and pragmatic business and product acumen.",
    name: "Peter Milne",
    role: "Trusted advisor",
  },
  {
    quote: "Pierre consistently brought clarity, strategic insight, and a deep understanding of enterprise data challenges. He combines strong product vision with a pragmatic, execution-focused approach.",
    name: "Finance leader",
    role: "Anonymous enterprise software company",
  },
];

const tools = [
  { href: "/tools/ai-readiness-checklist", label: "AI readiness" },
  { href: "/tools/data-readiness", label: "Data readiness" },
  { href: "/tools/ai-approach-finder", label: "AI approach" },
  { href: "/tools/ai-business-case-scorecard", label: "Business case" },
  { href: "/tools/ai-project-scoper", label: "Project scope" },
];

const careerMarks = [
  { name: "Adform", src: "/logos/adform.svg" },
  { name: "Sitecore", src: "/logos/sitecore.svg" },
  { name: "Amilia", src: "/logos/amilia.svg" },
];
---

<BaseLayout>
  <HeaderNav ctaHref={contactHref} ctaLabel={hero.headerCtaLabel} sections={siteData.navigation} />

  <main id="main-content">
    <section class="home-hero">
      <div class="home-wrap">
        <p class="home-eyebrow home-hero__label"><span class="home-hero__dot" aria-hidden="true"></span>{hero.eyebrow}</p>
        <div class="home-hero__grid">
          <div>
            <h1><span>From AI</span> <span>ambition to</span> <em>shipped</em> <em>products.</em></h1>
            <p class="home-hero__intro">I’m <strong>{hero.name}</strong>. {hero.supportingText}</p>
            <p class="home-hero__role">
              <strong>{career.currentRole} at {career.currentEmployer}.</strong>
              <span>Creator of Omni-loop.</span>
            </p>
            <div class="home-hero__actions">
              <a class="home-button" href={contactHref}>{hero.primaryCtaLabel} <span aria-hidden="true">↗</span></a>
              <a class="home-link" href={resumeHref}>{hero.resumeCtaLabel} <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <figure class="home-portrait">
            <div class="home-portrait__frame">
              <img src={withBase("/pierre-derval-profile.webp")} alt="Portrait of Pierre Derval" width="1024" height="1536" loading="eager" decoding="async" />
            </div>
            <figcaption><em>{hero.brandLine}</em><span>20+ years in enterprise software</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="home-career" aria-label="Selected career experience">
      <div class="home-wrap">
        <p class="home-eyebrow">Built across enterprise software</p>
        <ul class="home-career__logos">
          <li><span class="home-career__plaque"><img src={withBase("/logos/vertuoza.svg")} alt="Vertuoza" width="184" height="56" /></span></li>
          <li class="home-career__name">CluedIn</li>
          {careerMarks.map((mark) => (
            <li><img class="home-career__mark" src={withBase(mark.src)} alt={mark.name} /></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="home-work home-section" id="work" aria-labelledby="work-title">
      <div class="home-wrap">
        <div class="home-head">
          <div>
            <p class="home-eyebrow">What I’m building now · 2026</p>
            <h2 class="home-title" id="work-title">Engineering with working proof.</h2>
          </div>
        </div>
        <div class="home-work__panels">
          {career.proofPanels.map((panel) => (
            <article class="home-panel">
              <div class="home-panel__meta"><span><b>{panel.number}</b> · {panel.role}</span><span>{panel.context}</span></div>
              <h3 class:list={["home-panel__logo", `home-panel__logo--${panel.logoStyle}`]}>
                <img src={withBase(panel.logoPath)} alt={panel.name} width={panel.logoWidth} height={panel.logoHeight} />
              </h3>
              <div class="home-panel__figure">
                <p class="home-panel__big" set:html={panel.headlineHtml} />
                <p class="home-panel__sub">{panel.subline}</p>
              </div>
              <ul class="home-panel__points">
                {panel.points.map((point) => <li>{point}</li>)}
              </ul>
              <a class="home-panel__link" href={panel.url} target="_blank" rel="noopener noreferrer">Explore {panel.name} ↗</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-eng" id="engineering" aria-labelledby="engineering-title">
      <div class="home-wrap">
        <div class="home-head">
          <div>
            <p class="home-eyebrow">Engineering leadership</p>
            <h2 class="home-title" id="engineering-title">I run the teams that build it.</h2>
          </div>
          <p class="home-head__note">Lead developer, principal architect, then the executive both product and engineering reported to.</p>
        </div>
        <dl class="home-eng__list">
          {career.engineeringLeadership.map((item) => (
            <div class="home-eng__row">
              <dt>{item.label}</dt>
              <dd>{item.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="home-proof home-section" id="experience" aria-labelledby="experience-title">
      <div class="home-wrap">
        <div class="home-head">
          <div>
            <p class="home-eyebrow">{career.priorOutcomesLabel}</p>
            <h2 class="home-title" id="experience-title">A career spent closing the gap.</h2>
          </div>
          <p class="home-head__note">From enterprise data platforms to AI delivery. These results come from earlier roles, before Vertuoza.</p>
        </div>
        <div class="home-metrics">
          {career.homeOutcomes.map((outcome) => (
            <div class="home-metric">
              <span class="home-metric__value">{outcome.value}</span>
              <span class="home-metric__label">{outcome.label}</span>
              <span class="home-metric__source">{outcome.source}</span>
            </div>
          ))}
        </div>
        <figure class="home-quote">
          <blockquote>“{featuredQuote.quote}”</blockquote>
          <figcaption><strong>{featuredQuote.name}</strong>{featuredQuote.role}</figcaption>
        </figure>
        <div class="home-quotes">
          {otherQuotes.map((item) => (
            <figure>
              <blockquote>“{item.quote}”</blockquote>
              <figcaption><strong>{item.name}</strong>{item.role}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section" id="advisory" aria-labelledby="advisory-title">
      <div class="home-wrap">
        <div class="home-head">
          <div>
            <p class="home-eyebrow">For CEOs and CTOs</p>
            <h2 class="home-title" id="advisory-title">Where I can help.</h2>
          </div>
          <p class="home-head__note">When ambition is clear but the path is not, I help connect the business decision to the team and platform that have to deliver it.</p>
        </div>
        <div>
          {engagements.map((engagement, index) => (
            <a class="exec-engagement" href={withBase("/services") + `#${engagement.id}`}>
              <span class="exec-engagement__number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{engagement.title}</h3>
              <p>{engagement.summary}</p>
              <span class="exec-engagement__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-writing" id="writing" aria-labelledby="writing-title">
      <div class="home-wrap">
        <div class="home-head">
          <div>
            <p class="home-eyebrow">Writing &amp; practical tools</p>
            <h2 class="home-title" id="writing-title">A point of view. Something you can use.</h2>
          </div>
          <a class="home-link" href={withBase("/blog")}>All articles <span aria-hidden="true">↗</span></a>
        </div>
        <div class="home-articles">
          {articles.map((post) => (
            <a class="home-article" href={withBase(`/blog/${post.slug}`)}>
              {post.data.image && (
                <div class="home-article__image">
                  <img src={withBase(post.data.image)} alt="" width="900" height="470" loading="lazy" decoding="async" />
                </div>
              )}
              <span class="home-article__meta">{post.data.category} · {formatDate(post.data.publishDate)}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.excerpt}</p>
            </a>
          ))}
        </div>
        <div class="home-tools">
          <div>
            <h3>Five tools for better AI decisions.</h3>
            <ul>
              {tools.map((tool) => <li><a href={withBase(tool.href)}>{tool.label}</a></li>)}
            </ul>
          </div>
          <a class="home-link" href={withBase("/tools")}>Explore diagnostics <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="home-closing" id="contact" aria-labelledby="closing-title">
      <div class="home-wrap">
        <div>
          <p class="home-eyebrow">Start a conversation</p>
          <h2 id="closing-title">What needs to move forward?</h2>
        </div>
        <div class="home-closing__side">
          <p>Tell me what you are trying to change, where things stand and what is getting in the way.</p>
          <a class="home-button" href={contactHref}>{hero.primaryCtaLabel} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
