---
import { siteData } from "../data/site";
import BaseLayout from "./BaseLayout.astro";
import HeaderNav from "../components/HeaderNav.astro";
import { withBase } from "../utils/url";

interface Props {
  title: string;
  description: string;
  isArticle?: boolean;
  publishDate?: Date;
  updatedDate?: Date;
  image?: string;
  imageAlt?: string;
  author?: string;
  category?: string;
  profilePage?: boolean;
}

const {
  title,
  description,
  isArticle = false,
  publishDate,
  updatedDate,
  image,
  author,
  category,
  profilePage = false,
} = Astro.props;
---

<BaseLayout {title} {description} ogType={isArticle ? "article" : "website"} image={isArticle ? image : undefined} {profilePage}>
  <Fragment slot="head">
    {isArticle && (
      <>
        {author && <meta property="article:author" content={author} />}
        {publishDate && (
          <meta
            property="article:published_time"
            content={publishDate.toISOString()}
          />
        )}
        {(updatedDate ?? publishDate) && (
          <meta
            property="article:modified_time"
            content={(updatedDate ?? publishDate)!.toISOString()}
          />
        )}
        {category && (
          <meta property="article:section" content={category} />
        )}
      </>
    )}
  </Fragment>

  <HeaderNav
    ctaHref={withBase("/contact")}
    ctaLabel={siteData.hero.headerCtaLabel}
    sections={siteData.navigation}
  />

  <main id="main-content">
    <slot />
  </main>
</BaseLayout>
