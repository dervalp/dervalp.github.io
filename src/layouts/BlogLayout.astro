---
import { siteData } from "../data/site";
import BaseLayout from "./BaseLayout.astro";
import HeaderNav from "../components/HeaderNav.astro";
import { absoluteUrl, canonicalHref, withBase } from "../utils/url";

interface Props {
  title: string;
  description: string;
  isArticle?: boolean;
  publishDate?: Date;
  updatedDate?: Date;
  image?: string;
  imageAlt?: string;
  author?: string;
  category?: string;
  profilePage?: boolean;
  noindex?: boolean;
  tags?: string[];
}

const {
  title,
  description,
  isArticle = false,
  publishDate,
  updatedDate,
  image,
  author,
  category,
  profilePage = false,
  noindex = false,
  tags = [],
} = Astro.props;

// Articles describe themselves as a BlogPosting written by the site's Person.
const siteRootUrl = Astro.site
  ? canonicalHref(import.meta.env.BASE_URL || "/", Astro.site)
  : undefined;
const articleUrl = Astro.site
  ? canonicalHref(Astro.url.pathname, Astro.site)
  : undefined;
const articleData =
  isArticle && siteRootUrl && articleUrl && publishDate
    ? [
        {
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          "@id": `${articleUrl}#article`,
          headline: title.replace(` | ${siteData.hero.name}`, ""),
          description,
          url: articleUrl,
          mainEntityOfPage: articleUrl,
          datePublished: publishDate.toISOString(),
          dateModified: (updatedDate ?? publishDate).toISOString(),
          inLanguage: "en",
          author: { "@id": `${siteRootUrl}#person` },
          publisher: { "@id": `${siteRootUrl}#person` },
          isPartOf: { "@id": `${siteRootUrl}#website` },
          ...(image ? { image: absoluteUrl(image, Astro.site) } : {}),
          ...(category ? { articleSection: category } : {}),
          ...(tags.length > 0 ? { keywords: tags.join(", ") } : {}),
        },
      ]
    : [];
---

<BaseLayout {title} {description} ogType={isArticle ? "article" : "website"} image={isArticle ? image : undefined} {profilePage} {noindex} extraStructuredData={articleData}>
  <Fragment slot="head">
    {isArticle && (
      <>
        {author && <meta property="article:author" content={author} />}
        {publishDate && (
          <meta
            property="article:published_time"
            content={publishDate.toISOString()}
          />
        )}
        {(updatedDate ?? publishDate) && (
          <meta
            property="article:modified_time"
            content={(updatedDate ?? publishDate)!.toISOString()}
          />
        )}
        {category && (
          <meta property="article:section" content={category} />
        )}
      </>
    )}
  </Fragment>

  <HeaderNav
    ctaHref={withBase("/contact")}
    ctaLabel={siteData.hero.headerCtaLabel}
    sections={siteData.navigation}
  />

  <main id="main-content">
    <slot />
  </main>
</BaseLayout>
