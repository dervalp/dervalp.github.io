---
import "../styles/global.css";
import "../styles/executive.css";
import { siteData } from "../data/site";
import { absoluteUrl, canonicalHref, withBase } from "../utils/url";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
  profilePage?: boolean;
  noindex?: boolean;
  extraStructuredData?: Record<string, unknown>[];
}

const {
  title = siteData.seo.title,
  description = siteData.seo.description,
  ogType = "website",
  image,
  profilePage = false,
  noindex = false,
  extraStructuredData = []
} = Astro.props;

const canonicalUrl = Astro.site
  ? canonicalHref(Astro.url.pathname, Astro.site)
  : undefined;
const siteRootUrl = Astro.site
  ? canonicalHref(import.meta.env.BASE_URL || "/", Astro.site)
  : undefined;
const ogImageUrl = absoluteUrl(image ?? siteData.seo.ogImage, Astro.site);
const ogImagePath = image ?? siteData.seo.ogImage;
const ogImageType = /\.jpe?g$/i.test(ogImagePath)
  ? "image/jpeg"
  : /\.webp$/i.test(ogImagePath)
    ? "image/webp"
    : "image/png";
const feedUrl = absoluteUrl("/rss.xml", Astro.site);
const sameAs = [
  siteData.socials.linkedinUrl,
  siteData.socials.githubUrl,
  siteData.socials.xUrl
];
const faviconHref = withBase(siteData.seo.favicon);
const personId = `${siteRootUrl}#person`;
const structuredData = siteRootUrl
  ? [
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": `${siteRootUrl}#website`,
        name: siteData.seo.siteName,
        url: siteRootUrl,
        description: siteData.seo.description,
        inLanguage: "en-BE",
        publisher: { "@id": personId }
      },
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": personId,
        name: siteData.hero.name,
        url: siteRootUrl,
        description: siteData.seo.description,
        jobTitle: siteData.career.currentRole,
        worksFor: {
          "@type": "Organization",
          name: siteData.career.currentEmployer,
          url: "https://www.vertuoza.com/"
        },
        image: absoluteUrl("/pierre-derval-profile.webp", Astro.site),
        sameAs,
        knowsAbout: [
          "Engineering leadership",
          "Software architecture",
          "AI-assisted engineering",
          "Platform strategy",
          "Enterprise software",
          "Product leadership"
        ]
      },
      ...(profilePage && canonicalUrl
        ? [
            {
              "@context": "https://schema.org",
              "@type": "ProfilePage",
              "@id": `${canonicalUrl}#profile`,
              url: canonicalUrl,
              name: title,
              mainEntity: { "@id": personId }
            }
          ]
        : []),
      ...extraStructuredData
    ]
  : undefined;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#f5f1e9" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add("js");
      (() => {
        const storageKey = "pierre-theme";
        const themeColors = {
          light: "#f5f1e9",
          dark: "#17211b"
        };

        try {
          const savedTheme = window.localStorage.getItem(storageKey);
          const theme = savedTheme === "dark" || savedTheme === "light"
            ? savedTheme
            : "light";
          document.documentElement.dataset.theme = theme;
          const themeMeta = document.querySelector('meta[name="theme-color"]');
          themeMeta?.setAttribute("content", themeColors[theme]);
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-41795XWWS0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());
      gtag("config", "G-41795XWWS0");
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteData.seo.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={siteData.seo.locale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={siteData.seo.ogImageAlt} />
    <meta property="og:image:type" content={ogImageType} />
    {!image && (
      <>
        <meta property="og:image:width" content={String(siteData.seo.ogImageWidth)} />
        <meta property="og:image:height" content={String(siteData.seo.ogImageHeight)} />
      </>
    )}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={siteData.seo.ogImageAlt} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteData.seo.siteName} blog`} href={feedUrl} />
    <link rel="me" href={siteData.socials.linkedinUrl} />
    <link rel="me" href={siteData.socials.githubUrl} />
    <link rel="me" href={siteData.socials.xUrl} />
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />

    <footer class="site-footer exec-footer">
      <div class="shell">
        <div class="exec-footer__grid">
          <div class="exec-footer__brand">
            <a href={withBase("/")} aria-label="Pierre Derval, home">
              <img class="exec-footer__logo" src={withBase("/pierre-derval-logo-white.svg")} alt="Pierre Derval" width="266" height="35" />
            </a>
            <p class="exec-footer__tagline">{siteData.hero.brandLine}</p>
            <p class="exec-footer__note">Based in Belgium. Working across enterprise software.</p>
          </div>
          <div>
            <h2>Explore</h2>
            <ul>
              {siteData.navigation.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Connect</h2>
            <ul>
              <li><a href={siteData.socials.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
              <li><a href={siteData.socials.githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
              <li><a href={siteData.socials.xUrl} target="_blank" rel="noopener noreferrer">X ↗</a></li>
              <li><a href={withBase(siteData.socials.resumePath)}>{siteData.hero.resumeCtaLabel} ↓</a></li>
              <li><a href={withBase("/contact")}>Contact ↗</a></li>
            </ul>
          </div>
        </div>
        <div class="exec-footer__bottom">
          <span>© {new Date().getFullYear()} {siteData.hero.name}</span>
          <span>Technology &amp; AI Executive · Enterprise SaaS</span>
        </div>
      </div>
    </footer>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
