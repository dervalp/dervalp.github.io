---
import type { NavItem } from "../data/site";
import { withBase } from "../utils/url";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  sections: NavItem[];
  ctaHref: string;
  ctaLabel: string;
}

const { sections, ctaHref, ctaLabel } = Astro.props;

// Normalise path for server-side active state on page-link nav items
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathWithoutBase = Astro.url.pathname.replace(base, "") || "/";
---

<header class="site-header">
  <div class="shell">
    <div class="site-header__bar">
      <a class="site-header__brand" href={withBase("/")} aria-label="Pierre Derval, home">
        <img class="site-header__logo site-header__logo--dark" src={withBase("/pierre-derval-logo.svg")} alt="Pierre Derval" width="254" height="44" />
        <img class="site-header__logo site-header__logo--light" src={withBase("/pierre-derval-logo-white.svg")} alt="Pierre Derval" width="254" height="44" />
      </a>

      <nav aria-label="Primary" class="site-header__nav">
        {
          sections.map((section) => {
            const isActive = pathWithoutBase.startsWith(section.href);
            return (
              <a
                class="nav-link"
                data-active={isActive ? "true" : "false"}
                href={withBase(section.href)}
                aria-current={isActive ? "page" : undefined}
              >
                {section.label}
              </a>
            );
          })
        }
      </nav>

      <div class="site-header__actions">
        <a class="site-header__talk" href={ctaHref}>{ctaLabel} <span aria-hidden="true">↗</span></a>
        <ThemeToggle />
        <details class="site-header__menu">
          <summary aria-label="Navigation menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </summary>
          <nav aria-label="Menu">
            {sections.map((section) => <a href={withBase(section.href)}>{section.label}</a>)}
            <a href={ctaHref}>{ctaLabel}</a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
